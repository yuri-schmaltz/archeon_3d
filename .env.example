# =============================================================================
# Archeon 3D — backend environment
# =============================================================================
# Copy this file to `.env` (which is gitignored) and adjust values for your
# setup. The values below are the documented defaults; the server falls back
# to them if the env vars are unset.
#
# Quick reference:
#   cp .env.example .env
#   docker compose --env-file .env up
#   # or, for local dev:
#   make dev
# =============================================================================


# -----------------------------------------------------------------------------
# Server binding
# -----------------------------------------------------------------------------
# Where the Archeon API listens. In Docker, ``0.0.0.0`` lets the container
# accept external connections; for local dev, ``127.0.0.1`` is safer.
ARCHEON_HOST=0.0.0.0
ARCHEON_PORT=8081

# Number of uvicorn workers. Only 1 is supported: inference is serialised
# through a single in-process queue on one GPU, and each extra worker would
# load its own copy of the model into VRAM and rehydrate the job DB
# independently. Run one process per GPU instead.
ARCHEON_WORKERS=1


# -----------------------------------------------------------------------------
# API key auth
# -----------------------------------------------------------------------------
# When set, /v1 endpoints require an ``X-API-Key`` header
# matching this value. Leave empty to disable auth (dev / trusted networks).
# Generate one with: ``python -c 'import secrets; print(secrets.token_urlsafe(32))'``
ARCHEON_API_KEY=

# Comma-separated list of allowed CORS origins. ``*`` is permitted in dev
# but you should narrow this for any non-local deployment. The frontend dev
# server is on http://localhost:5173 by default.
ARCHEON_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Allow cookies / Authorization headers on cross-origin requests. Ignored
# (forced off) when ARCHEON_CORS_ORIGINS is ``*``, since browsers reject
# that combination.
ARCHEON_ALLOW_CREDENTIALS=false

# HMAC key used to sign /files download URLs (see GET /v1/jobs/{uid}/download-url).
# Leave empty to fall back to ARCHEON_API_KEY. When both are empty, signed
# URLs are disabled and clients must send X-API-Key.
ARCHEON_URL_SIGNING_KEY=

# Per-IP rate limit applied to the API routes (slowapi syntax: ``120/minute``,
# ``10/second``, ``1000/hour``). Leave empty to disable rate limiting.
ARCHEON_RATE_LIMIT=120/minute

# Maximum accepted request body, in bytes (default 64 MiB). Larger payloads
# are rejected with 413 before being buffered. Set to 0 to disable the guard.
# Keep in sync with client_max_body_size in nginx.conf.
ARCHEON_MAX_BODY_BYTES=67108864


# -----------------------------------------------------------------------------
# Device + model selection
# -----------------------------------------------------------------------------
# ``cuda`` (default) or ``cpu``. CPU is for tests / very small models only.
ARCHEON_DEVICE=cuda

# HuggingFace model id. Override to swap in a fine-tune or a Turbo variant.
ARCHEON_MODEL=tencent/Hunyuan3D-2
ARCHEON_MODEL_SUBFOLDER=hunyuan3d-dit-v2-0
ARCHEON_MULTIVIEW_MODEL=tencent/Hunyuan3D-2mv
ARCHEON_MULTIVIEW_SUBFOLDER=hunyuan3d-dit-v2-mv
ARCHEON_MINI_MODEL=tencent/Hunyuan3D-2mini

# Optional: pin the model cache. ``ARCHEON_HF_HOME`` takes precedence over
# the plain ``HF_HOME`` understood by huggingface_hub. Set to a large disk
# on dedicated GPU boxes.
# ARCHEON_HF_HOME=/path/to/huggingface-cache

# Inference topology. When true (default) the API manager delegates to a
# shared InferenceService that owns the queue and the model instance. Set to
# false only to fall back to the manager's embedded worker loop (tests).
ARCHEON_USE_SHARED_INFERENCE=true


# -----------------------------------------------------------------------------
# Storage paths
# -----------------------------------------------------------------------------
# Where generated meshes (.glb / .obj / ...) are written. The server also
# serves them back at ``/files/<basename>`` for download. Defaults to
# ``$XDG_CACHE_HOME/hy3dgen/archeon`` (typically ``~/.cache/hy3dgen/archeon``).
ARCHEON_SAVE_DIR=

# SQLite-backed job persistence. Empty string disables persistence entirely
# (jobs live only in memory and are lost on restart). Default is
# ``$XDG_STATE_HOME/hy3dgen/archeon/jobs.db`` (~/.local/state/...).
ARCHEON_JOB_DB=

# Cap the in-memory job history. Eviction also deletes from the SQLite store.
ARCHEON_MAX_HISTORY=1000

# Drop terminal jobs older than this many seconds (24h default).
ARCHEON_MAX_AGE_SECONDS=86400


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level for the API: DEBUG / INFO / WARNING / ERROR.
ARCHEON_LOG_LEVEL=INFO

# If set, logs are also written to this file (with rotation at 50 MB, keeping
# 5 backups). Leave empty to log only to stderr (suitable for Docker).
ARCHEON_LOG_FILE=

# Emit logs as one JSON object per line instead of plain text
# (for Loki / Datadog / Google Cloud Logging).
ARCHEON_LOG_JSON=false

# Export OpenTelemetry spans around inference. Requires the ``otel`` extra
# (pip install -e '.[otel]'); without it the server stays on no-op spans.
ARCHEON_OTEL_ENABLED=false


# -----------------------------------------------------------------------------
# Mesh post-processing defaults
# -----------------------------------------------------------------------------
# When the client doesn't override these, the manager uses them as defaults.
ARCHEON_DEFAULT_SEED=1234
ARCHEON_DEFAULT_STEPS=50
ARCHEON_DEFAULT_GUIDANCE=5.0
ARCHEON_DEFAULT_OCTREE=256
ARCHEON_DEFAULT_FACE_COUNT=40000
