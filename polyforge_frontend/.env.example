# Copy to .env for local development. Do not include /v1 in this URL.
VITE_API_URL=http://localhost:8081

# The local launcher serves the built UI and API from the same origin:
# VITE_API_URL=
#
# If the backend requires POLYFORGE_API_KEY, enter it in the UI at runtime.
# VITE_* values are public build configuration; API keys do not belong here.
